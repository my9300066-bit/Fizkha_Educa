                        </button>
                    </div>
                </div>

                <!-- Subjects Grid -->
                <div>
                    <h4 class="font-bold text-slate-700 mb-4 flex items-center gap-2">
                        <i class="fa-solid fa-shapes text-yellow-500"></i> Pilih Mata Pelajaran:
                    </h4>
                    <div id="subjectsContainer" class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        <!-- Dynamic Subjects rendered here -->
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= LEARNING MATERIAL SECTION ================= -->
        <section id="materialSection" class="hidden space-y-6">
            <!-- Back & Header -->
            <div class="flex items-center justify-between gap-4">
                <button onclick="showSection('dashboard')" class="bg-white text-slate-700 font-bold px-4 py-2 rounded-2xl border border-slate-200 hover:bg-slate-50 flex items-center gap-2 text-sm">
                    <i class="fa-solid fa-arrow-left"></i> Kembali ke Dashboard
                </button>
                <div class="text-right">
                    <span id="matSubjectBadge" class="bg-indigo-100 text-indigo-700 text-xs font-bold px-3 py-1 rounded-full uppercase"></span>
                </div>
            </div>

            <!-- Material Card -->
            <div class="bg-white rounded-3xl p-6 md:p-8 card-shadow border border-indigo-100 space-y-6">
                <!-- Header Info -->
                <div class="border-b border-slate-100 pb-4">
                    <h2 id="matTopicTitle" class="text-2xl md:text-3xl font-extrabold text-indigo-950">Membaca Materi...</h2>
                    <p id="matSubtitle" class="text-slate-500 text-sm mt-1"></p>
                </div>

                <!-- AI Loading State -->
                <div id="materialLoading" class="py-12 text-center space-y-4">
                    <div class="inline-block animate-bounce bg-indigo-100 text-indigo-600 p-4 rounded-full text-3xl">
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                    </div>
                    <p class="text-lg font-bold text-indigo-900">Gemini AI sedang menyiapkan rangkuman materi super seru...</p>
                    <p class="text-xs text-slate-400">Menyesuaikan Kurikulum Merdeka untuk <span id="loadingStudentName">anak</span>...</p>
                </div>

                <!-- Material Content -->
                <div id="materialContent" class="hidden space-y-6 text-slate-700 leading-relaxed text-base md:text-lg">
                    <!-- Dynamic Material HTML inserted here -->
                </div>

                <!-- Footer Action to Quiz -->
                <div id="materialFooter" class="hidden pt-6 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4">
                    <div class="flex items-center gap-3 text-green-600 font-bold text-sm">
                        <i class="fa-solid fa-circle-check text-2xl"></i>
                        <span>Hebat! Kamu sudah selesai membaca materi ini.</span>
                    </div>
                    <button onclick="generateQuiz()" class="w-full sm:w-auto bg-gradient-to-r from-green-500 to-emerald-600 hover:from-green-600 hover:to-emerald-700 text-white font-extrabold text-lg px-8 py-4 rounded-2xl shadow-lg hover:shadow-xl transition transform hover:-translate-y-0.5 flex items-center justify-center gap-3">
                        <i class="fa-solid fa-gamepad text-yellow-300"></i>
                        <span>Mulai Kuis 20 Soal!</span>
                    </button>
                </div>
            </div>
        </section>

        <!-- ================= QUIZ SECTION ================= -->
        <section id="quizSection" class="hidden space-y-6">
            <!-- Quiz Progress & Header -->
            <div class="bg-white rounded-3xl p-6 card-shadow border border-indigo-100 flex flex-col md:flex-row justify-between items-center gap-4">
                <div class="flex items-center gap-4 w-full md:w-auto">
                    <div id="quizAvatar" class="w-12 h-12 rounded-2xl bg-indigo-500 text-white text-xl flex items-center justify-center font-bold">
                        🎓
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-slate-800" id="quizHeaderStudent">Kuis Interaktif</h3>
                        <p class="text-xs text-slate-500" id="quizHeaderInfo">20 Soal Pilihan Ganda</p>
                    </div>
                </div>

                <!-- Progress Bar -->
                <div class="w-full md:w-64 space-y-1">
                    <div class="flex justify-between text-xs font-bold text-indigo-900">
                        <span>Progress Soal</span>
                        <span id="quizProgressText">Soal 1 dari 20</span>
                    </div>
                    <div class="w-full bg-slate-100 rounded-full h-3 overflow-hidden">
                        <div id="quizProgressBar" class="bg-indigo-500 h-full rounded-full transition-all duration-300" style="width: 5%"></div>
                    </div>
                </div>
            </div>

            <!-- AI Quiz Loading State -->
            <div id="quizLoading" class="bg-white rounded-3xl p-12 text-center space-y-4 card-shadow">
                <div class="inline-block animate-spin text-4xl text-yellow-500">
                    <i class="fa-solid fa-spinner"></i>
                </div>
                <h3 class="text-xl font-bold text-indigo-950">Sedang Membuat 20 Soal Kuis Pilihan Ganda...</h3>
                <p class="text-slate-500 text-sm">Menyiapkan soal yang pas dan menyenangkan sesuai materi Kurikulum Merdeka!</p>
            </div>

            <!-- Quiz Card -->
            <div id="quizBox" class="hidden bg-white rounded-3xl p-6 md:p-8 card-shadow border-2 border-indigo-100 space-y-6">
                <!-- Question Title -->
                <div class="space-y-2">
                    <span class="bg-indigo-100 text-indigo-700 text-xs font-bold px-3 py-1 rounded-full uppercase" id="questionNumberBadge">Soal #1</span>
                    <h2 class="text-xl md:text-2xl font-bold text-slate-800" id="questionText">Pertanyaan kuis akan tampil di sini?</h2>
                </div>

                <!-- Options -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="optionsContainer">
                    <!-- Options buttons dynamic -->
                </div>

                <!-- Feedback Banner -->
                <div id="feedbackBox" class="hidden p-4 rounded-2xl font-bold flex items-center justify-between">
                    <span id="feedbackText"></span>
                    <button id="nextBtn" onclick="nextQuestion()" class="bg-slate-800 text-white text-sm px-5 py-2.5 rounded-xl hover:bg-slate-900 transition">
                        Soal Berikutnya <i class="fa-solid fa-arrow-right ml-1"></i>
                    </button>
                </div>
            </div>
        </section>

        <!-- ================= QUIZ RESULT SECTION ================= -->
        <section id="resultSection" class="hidden space-y-6 max-w-2xl mx-auto text-center">
            <div class="bg-white rounded-3xl p-8 md:p-12 card-shadow border-4 border-yellow-300 space-y-6 relative overflow-hidden">
                <div class="text-6xl mb-2" id="resultEmoji">🎉</div>
                
                <h2 class="text-3xl font-extrabold text-indigo-950" id="resultTitle">Luar Biasa!</h2>
                <p class="text-slate-600" id="resultSubtitle">Kamu telah menyelesaikan 20 soal kuis!</p>

                <!-- Score Board -->
                <div class="bg-indigo-50 rounded-2xl p-6 max-w-sm mx-auto border border-indigo-100 space-y-2">
                    <span class="text-xs font-extrabold text-indigo-500 uppercase tracking-wider">Nilai Akhir Kamu</span>
                    <div class="text-6xl font-black text-indigo-600" id="finalScore">100</div>
                    <p class="text-sm font-semibold text-slate-600" id="scoreDetails">Benar 20 dari 20 Soal</p>
                </div>

                <!-- Buttons -->
                <div class="flex flex-col sm:flex-row gap-3 justify-center pt-4">
                    <button onclick="showSection('dashboard')" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-6 py-3 rounded-xl transition shadow-md">
                        <i class="fa-solid fa-house mr-2"></i> Kembali ke Dashboard
                    </button>
                    <button onclick="generateQuiz()" class="bg-yellow-400 hover:bg-yellow-500 text-indigo-950 font-bold px-6 py-3 rounded-xl transition shadow-md">
                        <i class="fa-solid fa-rotate-right mr-2"></i> Coba Kuis Lagi
                    </button>
                </div>
            </div>
        </section>

        <!-- ================= PARENT DASHBOARD MODAL ================= -->
        <div id="parentModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
            <div class="bg-white rounded-3xl max-w-3xl w-full max-h-[90vh] overflow-y-auto card-shadow p-6 md:p-8 space-y-6 border-2 border-purple-200">
                
                <!-- PIN verification form -->
                <div id="parentPinState" class="space-y-4 text-center py-6">
                    <div class="w-16 h-16 bg-purple-100 text-purple-600 rounded-full flex items-center justify-center mx-auto text-2xl font-bold">
                        <i class="fa-solid fa-lock"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-slate-800">Verifikasi Orang Tua</h3>
                    <p class="text-slate-500 text-sm">Masukkan PIN Orang Tua (Default: <span class="font-mono font-bold text-purple-600">1234</span>)</p>
                    
                    <div class="flex justify-center gap-2 max-w-xs mx-auto">
                        <input type="password" id="parentPinInput" maxlength="4" placeholder="1234" class="text-center text-2xl font-bold tracking-widest w-full py-3 border-2 border-slate-200 rounded-xl focus:border-purple-500 outline-none">
                    </div>
                    
                    <div class="flex justify-center gap-3 pt-2">
                        <button onclick="closeParentModal()" class="bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold px-5 py-2.5 rounded-xl text-sm">Batal</button>
                        <button onclick="verifyParentPin()" class="bg-purple-600 hover:bg-purple-700 text-white font-bold px-6 py-2.5 rounded-xl text-sm shadow">Masuk Portal</button>
                    </div>
                </div>

                <!-- Parent Dashboard View -->
                <div id="parentDashboardState" class="hidden space-y-6">
                    <div class="flex justify-between items-center border-b pb-4">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-purple-600 text-white rounded-xl flex items-center justify-center font-bold">
                                <i class="fa-solid fa-chart-line"></i>
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-slate-800">Halaman Kontrol Orang Tua</h3>
                                <p class="text-xs text-slate-500">Pantau perkembangan belajar Khalilatul & Hafiz</p>
                            </div>
                        </div>
                        <button onclick="closeParentModal()" class="text-slate-400 hover:text-slate-600 text-xl font-bold">&times;</button>
                    </div>

                    <!-- Progress Summary Cards -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- Khalilatul Stats -->
                        <div class="bg-pink-50 rounded-2xl p-4 border border-pink-100 space-y-3">
                            <div class="flex justify-between items-center">
                                <span class="font-bold text-pink-900">Khalilatul Ilmiyah (Kelas 3)</span>
                                <span id="khalilatulCount" class="text-xs bg-pink-200 text-pink-800 font-bold px-2 py-0.5 rounded-full">0 Kuis Selesai</span>
                            </div>
                            <div class="text-xs text-slate-600 space-y-1">
                                <p>Rata-rata Nilai: <span id="khalilatulAvg" class="font-bold text-pink-600">0</span></p>
                                <p>Materi Terakhir: <span id="khalilatulLastMat" class="font-semibold text-slate-700">-</span></p>
                            </div>
                        </div>

                        <!-- Hafiz Stats -->
                        <div class="bg-blue-50 rounded-2xl p-4 border border-blue-100 space-y-3">
                            <div class="flex justify-between items-center">
                                <span class="font-bold text-blue-900">Hafiz Muayyad (Kelas 1)</span>
                                <span id="hafizCount" class="text-xs bg-blue-200 text-blue-800 font-bold px-2 py-0.5 rounded-full">0 Kuis Selesai</span>
                            </div>
                            <div class="text-xs text-slate-600 space-y-1">
                                <p>Rata-rata Nilai: <span id="hafizAvg" class="font-bold text-blue-600">0</span></p>
                                <p>Materi Terakhir: <span id="hafizLastMat" class="font-semibold text-slate-700">-</span></p>
                            </div>
                        </div>
                    </div>

                    <!-- History Table -->
                    <div>
                        <h4 class="font-bold text-slate-700 mb-3 text-sm flex items-center justify-between">
                            <span><i class="fa-solid fa-clock-rotate-left mr-1"></i> Riwayat Kuis Terbaru</span>
                            <button onclick="clearHistory()" class="text-xs text-red-500 hover:underline">Hapus Riwayat</button>
                        </h4>
                        <div class="bg-slate-50 border rounded-2xl overflow-hidden max-h-60 overflow-y-auto">
                            <table class="w-full text-left text-xs">
                                <thead class="bg-slate-200 text-slate-700 font-bold uppercase sticky top-0">
                                    <tr>
                                        <th class="p-3">Nama</th>
                                        <th class="p-3">Pelajaran</th>
                                        <th class="p-3">Kelas / Sem</th>
                                        <th class="p-3">Nilai</th>
                                        <th class="p-3">Waktu</th>
                                    </tr>
                                </thead>
                                <tbody id="parentHistoryBody" class="divide-y divide-slate-200">
                                    <!-- History rows dynamic -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 py-4 mt-8">
        <div class="max-w-6xl mx-auto px-4 text-center text-xs text-slate-500">
            <p>© 2026 Aplikasi Belajar Interaktif Kurikulum Merdeka SD. Dibuat khusus untuk Khalilatul Ilmiyah & Hafiz Muayyad.</p>
        </div>
    </footer>

    <!-- JAVASCRIPT LOGIC -->
    <script>
        // DATA CURRICULUM MERDEKA SD
        const STUDENTS = {
            khalilatul: {
                id: 'khalilatul',
                name: 'Khalilatul Ilmiyah',
                grade: 3,
                gradeLabel: 'Kelas 3 SD',
                avatar: '👩‍🎓',
                color: 'pink',
                subjects: [
                    { id: 'pai3', name: 'PAI & Budi Pekerti', icon: 'fa-kaaba', color: 'bg-emerald-600',
                      sem1: ['Al-Qur\'an: Surah An-Nasr & Hukum Tajwid Dasar', 'Akidah: Asmaul Husna (Al-Wahid, Al-Ahad, As-Samad)', 'Akhlak: Sifat Jujur, Amanah, dan Adab Berteman', 'Fikih: Salat Fardu (Rukun & Bacaan)'],
                      sem2: ['Al-Qur\'an: Surah Al-Kausar & Menulis Hijaiyah Sambung', 'Akidah: Iman kepada Kitab-Kitab Allah', 'Akhlak: Hormat Guru, Sayang Teman, Hindari Sifat Sombong', 'Kisah Nabi: Keteladanan Nabi Ibrahim a.s. & Nabi Ismail a.s.'] },
                    { id: 'mat3', name: 'Matematika', icon: 'fa-calculator', color: 'bg-red-500', 
                      sem1: ['Bilangan Cacah Sampai 1.000', 'Penjumlahan & Pengurangan', 'Perkalian Dasar'],
                      sem2: ['Pembagian Dasar', 'Pecahan Sederhana', 'Pengukuran Panjang & Berat'] },
                    { id: 'ipas3', name: 'IPAS (IPA & IPS)', icon: 'fa-leaf', color: 'bg-green-500', 
                      sem1: ['Mari Kenali Hewan di Sekitar Kita', 'Siklus Hidup Makhluk Hidup', 'Komponen Ekosistem'],
                      sem2: ['Ragam Tradisi & Budaya Indonesia', 'Kebutuhan & Keinginan', 'Kenampakan Alam'] },
                    { id: 'indo3', name: 'Bahasa Indonesia', icon: 'fa-book', color: 'bg-blue-500', 
                      sem1: ['Membaca & Memahami Cerita', 'Kosa Kata Baru', 'Tanda Baca & Huruf Kapital'],
                      sem2: ['Menulis Paragraf Sederhana', 'Teks Petunjuk Sederhana', 'Puisi Anak'] },
                    { id: 'pancasila3', name: 'Pancasila (PPKn)', icon: 'fa-flag', color: 'bg-yellow-500', 
                      sem1: ['Simbol dan Makna Pancasila', 'Hak dan Kewajiban di Rumah & Sekolah'],
                      sem2: ['Keberagaman Suku dan Budaya', 'Musyawarah Sederhana'] }
                ]
            },
            hafiz: {
                id: 'hafiz',
                name: 'Hafiz Muayyad',
                grade: 1,
                gradeLabel: 'Kelas 1 SD',
                avatar: '👨‍🎓',
                color: 'blue',
                subjects: [
                    { id: 'pai1', name: 'PAI & Budi Pekerti', icon: 'fa-kaaba', color: 'bg-emerald-600', 
                      sem1: ['Al-Qur\'an: Huruf Hijaiyah Berharakat & Surah Al-Fatihah', 'Akidah: Rukun Iman, Ar-Rahman & Ar-Rahim', 'Akhlak: Basmalah, Hamdalah & Adab Makan Minum', 'Fikih: Bersuci (Thaharah), Wudu & Najis Ringan'],
                      sem2: ['Al-Qur\'an: Surah Al-Ikhlas & Membedakan Bunyi Hijaiyah', 'Akidah: Dua Kalimat Syahadat dan Artinya', 'Akhlak: Hormat Orang Tua, Guru & Berkata Baik', 'Kisah Nabi: Keteladanan Nabi Adam a.s. & Nabi Muhammad swt.'] },
                    { id: 'indo1', name: 'Bahasa Indonesia', icon: 'fa-font', color: 'bg-purple-500', 
                      sem1: ['Bunyi & Huruf A-Z, Suku Kata (ba-bi-bu)', 'Membaca Kata Bergambar & Anggota Tubuh', 'Menyimak Cerita Pendek & Kosa Kata Baru'],
                      sem2: ['Membaca Kalimat Sederhana & Tanda Baca ( . / ? )', 'Ungkapan Santun (Tolong, Maaf, Terima Kasih)', 'Menulis Kata & Menceritakan Pengalaman'] },
                    { id: 'mat1', name: 'Matematika', icon: 'fa-arrow-1-9', color: 'bg-orange-500', 
                      sem1: ['Mengenal Angka 1 sampai 10', 'Bentuk Bangun Datar', 'Mengelompokkan Benda'],
                      sem2: ['Penjumlahan Sederhana (1-20)', 'Pengurangan Sederhana (1-20)', 'Mengenal Jam & Waktu'] },
                    { id: 'pancasila1', name: 'Pancasila (PPKn)', icon: 'fa-shield-halved', color: 'bg-red-500', 
                      sem1: ['Simbol Garuda Pancasila', 'Aturan di Rumah'],
                      sem2: ['Aturan di Sekolah', 'Gotong Royong Bersama Teman'] },
                    { id: 'seni1', name: 'Seni & Budi Pekerti', icon: 'fa-palette', color: 'bg-teal-500', 
                      sem1: ['Mengenal Warna & Garis', 'Lagu-lagu Nasional Anak'],
                      sem2: ['Membuat Kerajinan dari Kertas', 'Sikap Sopan Santun'] }
                ]
            }
        };

        // GLOBAL APP STATE
        let currentStudent = null;
        let currentSemester = 1;
        let currentSubject = null;
        let currentTopic = '';
        let generatedQuizData = [];
        let currentQuizIndex = 0;
        let userAnswers = [];
        let score = 0;
        let parentPin = "1234";

        // APP INITIALIZATION
        window.onload = function() {
            renderParentHistory();
        };

        // NAVIGATION LOGIC
        function showSection(sectionId) {
            document.getElementById('dashboardSection').classList.add('hidden');
            document.getElementById('materialSection').classList.add('hidden');
            document.getElementById('quizSection').classList.add('hidden');
            document.getElementById('resultSection').classList.add('hidden');

            if (sectionId === 'dashboard') {
                document.getElementById('dashboardSection').classList.remove('hidden');
            } else if (sectionId === 'material') {
                document.getElementById('materialSection').classList.remove('hidden');
            } else if (sectionId === 'quiz') {
                document.getElementById('quizSection').classList.remove('hidden');
            } else if (sectionId === 'result') {
                document.getElementById('resultSection').classList.remove('hidden');
            }
        }

        // SELECT STUDENT
        function selectStudent(studentId) {
            currentStudent = STUDENTS[studentId];
            
            // Update UI Badges
            document.getElementById('activeProfileTag').classList.remove('hidden');
            document.getElementById('tagAvatar').innerText = currentStudent.avatar;
            document.getElementById('tagAvatar').className = `w-7 h-7 rounded-full flex items-center justify-center text-white text-xs font-bold ${currentStudent.color === 'pink' ? 'bg-pink-500' : 'bg-blue-500'}`;
            document.getElementById('tagName').innerText = currentStudent.name;
            document.getElementById('tagGrade').innerText = currentStudent.gradeLabel;

            // Highlight Cards
            document.getElementById('card-khalilatul').classList.remove('border-pink-500', 'bg-pink-50/30');
            document.getElementById('card-hafiz').classList.remove('border-blue-500', 'bg-blue-50/30');
            if (studentId === 'khalilatul') {
                document.getElementById('card-khalilatul').classList.add('border-pink-500', 'bg-pink-50/30');
            } else {
                document.getElementById('card-hafiz').classList.add('border-blue-500', 'bg-blue-50/30');
            }

            // Show Configuration Panel
            document.getElementById('configPanel').classList.remove('hidden');
            document.getElementById('selectedStudentTitle').innerText = `Materi untuk ${currentStudent.name}`;
            
            renderSubjects();
        }

        // SET SEMESTER
        function setSemester(sem) {
            currentSemester = sem;
            const btn1 = document.getElementById('btnSem1');
            const btn2 = document.getElementById('btnSem2');

            if (sem === 1) {
                btn1.className = "px-5 py-2 rounded-xl font-bold text-sm transition-all bg-white text-indigo-900 shadow-sm";
                btn2.className = "px-5 py-2 rounded-xl font-bold text-sm transition-all text-slate-500 hover:text-slate-800";
            } else {
                btn2.className = "px-5 py-2 rounded-xl font-bold text-sm transition-all bg-white text-indigo-900 shadow-sm";
                btn1.className = "px-5 py-2 rounded-xl font-bold text-sm transition-all text-slate-500 hover:text-slate-800";
            }
            renderSubjects();
        }

        // RENDER SUBJECTS & TOPICS
        function renderSubjects() {
            if (!currentStudent) return;
            const container = document.getElementById('subjectsContainer');
            container.innerHTML = '';

            currentStudent.subjects.forEach(sub => {
                const topics = currentSemester === 1 ? sub.sem1 : sub.sem2;
                
                const card = document.createElement('div');
                card.className = "bg-slate-50 rounded-2xl p-4 border border-slate-200 hover:border-indigo-400 transition cursor-pointer flex flex-col justify-between group";
                
                let topicsHTML = topics.map(t => `<li class="hover:text-indigo-600 transition" onclick="startLearning('${sub.name}', '${t}')"><i class="fa-solid fa-play text-[10px] text-yellow-500 mr-1.5"></i>${t}</li>`).join('');

                card.innerHTML = `
                    <div>
                        <div class="flex items-center gap-3 mb-3">
                            <div class="w-10 h-10 ${sub.color} text-white rounded-xl flex items-center justify-center text-lg shadow-sm">
                                <i class="fa-solid ${sub.icon}"></i>
                            </div>
                            <h5 class="font-bold text-slate-800 group-hover:text-indigo-600 transition">${sub.name}</h5>
                        </div>
                        <ul class="text-xs text-slate-600 space-y-2 mt-2 font-medium">
                            ${topicsHTML}
                        </ul>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        // START LEARNING & GENERATE MATERIAL VIA GEMINI AI
        async function startLearning(subjectName, topicName) {
            currentSubject = subjectName;
            currentTopic = topicName;

            showSection('material');

            document.getElementById('matSubjectBadge').innerText = `${currentStudent.gradeLabel} • ${subjectName} (Sem ${currentSemester})`;
            document.getElementById('matTopicTitle').innerText = topicName;
            document.getElementById('matSubtitle').innerText = `Materi Kurikulum Merdeka untuk ${currentStudent.name}`;
            
            document.getElementById('materialLoading').classList.remove('hidden');
            document.getElementById('materialContent').classList.add('hidden');
            document.getElementById('materialFooter').classList.add('hidden');
            document.getElementById('loadingStudentName').innerText = currentStudent.name;

            // Call Gemini API to generate material
            const systemPrompt = `Anda adalah guru SD yang sangat ramah, ceria, dan pandai menjelaskan pelajaran Kurikulum Merdeka Indonesia secara interaktif dan mudah dipahami oleh anak SD. Gunakan bahasa Indonesia yang menyenangkan, berikan contoh kehidupan sehari-hari, gunakan emoji, dan format HTML yang rapi (seperti <h3>, <p>, <ul>, <li>, <div> dengan styling kustom).`;
            const userQuery = `Buatkan penjelasan materi singkat, jelas, dan menarik untuk anak SD kelas ${currentStudent.grade} bernama ${currentStudent.name}. Topik: "${topicName}" pada mata pelajaran ${subjectName}. Buat dalam 3-4 poin pembahasan utama dengan gaya bahasa anak-anak yang semangat.`;

            try {
                const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        contents: [{ parts: [{ text: userQuery }] }],
                        systemInstruction: { parts: [{ text: systemPrompt }] }
                    })
                });

                const data = await response.json();
                const aiText = data.candidates?.[0]?.content?.parts?.[0]?.text || "<p>Materi pembelajaran berhasil dimuat. Silakan baca dan pelajari sebelum kuis.</p>";
                
                // Formatted content wrapper
                document.getElementById('materialContent').innerHTML = `
                    <div class="prose max-w-none space-y-4">
                        ${formatAITextToHTML(aiText)}
                    </div>
                `;

                document.getElementById('materialLoading').classList.add('hidden');
                document.getElementById('materialContent').classList.remove('hidden');
                document.getElementById('materialFooter').classList.remove('hidden');

            } catch (err) {
                console.error(err);
                // Fallback content if API encounters network issue
                document.getElementById('materialContent').innerHTML = `
                    <div class="bg-yellow-50 p-6 rounded-2xl border border-yellow-200">
                        <h3 class="font-bold text-yellow-800 text-lg mb-2">📌 Ringkasan Materi: ${topicName}</h3>
                        <p class="text-slate-700">Dalam topik ini, ${currentStudent.name} akan belajar memahami konsep dasar ${topicName} untuk ${currentStudent.gradeLabel}. Pelajari baik-baik sebelum memulai kuis 20 soal!</p>
                    </div>
                `;
                document.getElementById('materialLoading').classList.add('hidden');
                document.getElementById('materialContent').classList.remove('hidden');
                document.getElementById('materialFooter').classList.remove('hidden');
            }
        }

        function formatAITextToHTML(text) {
            // Converts simple markdown from AI response to styled HTML
            return text
                .replace(/### (.*)/g, '<h3 class="text-xl font-bold text-indigo-900 mt-4 mb-2 flex items-center gap-2"><i class="fa-solid fa-star text-yellow-400"></i> $1</h3>')
                .replace(/\*\*(.*?)\*\*/g, '<strong class="text-indigo-950 font-extrabold">$1</strong>')
                .replace(/^\* (.*)/gm, '<li class="ml-4 list-disc text-slate-700">$1</li>')
                .replace(/\n\n/g, '<br/>');
        }

        // GENERATE QUIZ VIA GEMINI API (20 MCQs)
        async function generateQuiz() {
            showSection('quiz');

            document.getElementById('quizHeaderStudent').innerText = `Kuis: ${currentTopic}`;
            document.getElementById('quizHeaderInfo').innerText = `${currentStudent.name} • ${currentStudent.gradeLabel}`;
            document.getElementById('quizAvatar').innerText = currentStudent.avatar;

            document.getElementById('quizLoading').classList.remove('hidden');
            document.getElementById('quizBox').classList.add('hidden');

            const systemPrompt = "Anda adalah pembuat soal kuis Kurikulum Merdeka SD. Buatkan tepat 20 soal kuis pilihan ganda yang ramah anak, berstruktur JSON, sesuai usia.";
            const userQuery = `Buatkan 20 Soal Kuis Pilihan Ganda tentang "${currentTopic}" (Mata Pelajaran: ${currentSubject}) untuk murid kelas ${currentStudent.grade} SD. Setiap soal memiliki 4 pilihan (A, B, C, D) untuk kelas 3, atau 3 pilihan untuk kelas 1. Pastikan JSON valid.`;

            const payload = {
                contents: [{ parts: [{ text: userQuery }] }],
                systemInstruction: { parts: [{ text: systemPrompt }] },
                generationConfig: {
                    responseMimeType: "application/json",
                    responseSchema: {
                        type: "ARRAY",
                        items: {
                            type: "OBJECT",
                            properties: {
                                question: { type: "STRING" },
                                options: { 
                                    type: "ARRAY", 
                                    items: { type: "STRING" } 
                                },
                                answerIndex: { type: "INTEGER" },
                                explanation: { type: "STRING" }
                            },
                            required: ["question", "options", "answerIndex", "explanation"]
                        }
                    }
                }
            };

            try {
                const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const data = await response.json();
                const jsonText = data.candidates?.[0]?.content?.parts?.[0]?.text;
                generatedQuizData = JSON.parse(jsonText);

                // Ensure exactly 20 questions fallback check
                if (!generatedQuizData || generatedQuizData.length === 0) {
                    throw new Error("Invalid Quiz Data");
                }

            } catch (err) {
                console.error("Quiz Gen Error:", err);
                // Fallback Mock Quiz Questions (20 items)
                generatedQuizData = Array.from({ length: 20 }, (_, i) => ({
                    question: `Soal Latihan Nomor ${i + 1}: Apakah kita harus rajin belajar ${currentSubject} tentang ${currentTopic}?`,
                    options: ["Sangat Harus & Semangat!", "Tidak Perlu", "Biasa Saja", "Nanti Saja"],
                    answerIndex: 0,
                    explanation: "Belajar membuat kita makin pintar dan hebat!"
                }));
            }

            // Reset Quiz State
            currentQuizIndex = 0;
            score = 0;
            userAnswers = [];

            document.getElementById('quizLoading').classList.add('hidden');
            document.getElementById('quizBox').classList.remove('hidden');

            renderCurrentQuestion();
        }

        // RENDER CURRENT QUESTION
        function renderCurrentQuestion() {
            const q = generatedQuizData[currentQuizIndex];
            
            // Progress Update
            const total = generatedQuizData.length;
            document.getElementById('quizProgressText').innerText = `Soal ${currentQuizIndex + 1} dari ${total}`;
            document.getElementById('quizProgressBar').style.width = `${((currentQuizIndex + 1) / total) * 100}%`;
            
            document.getElementById('questionNumberBadge').innerText = `Soal #${currentQuizIndex + 1}`;
            document.getElementById('questionText').innerText = q.question;

            // Hide Feedback
            const feedbackBox = document.getElementById('feedbackBox');
            feedbackBox.className = "hidden p-4 rounded-2xl font-bold flex items-center justify-between";

            // Render Options
            const optsContainer = document.getElementById('optionsContainer');
            optsContainer.innerHTML = '';

            const optionLabels = ['A', 'B', 'C', 'D'];

            q.options.forEach((optText, idx) => {
                const btn = document.createElement('button');
                btn.className = "w-full text-left p-4 rounded-2xl border-2 border-slate-200 hover:border-indigo-400 hover:bg-indigo-50/50 transition font-semibold flex items-center gap-3 text-slate-700 option-btn";
                btn.onclick = () => checkAnswer(idx);
                
                btn.innerHTML = `
                    <span class="w-8 h-8 rounded-xl bg-slate-100 border border-slate-300 text-slate-700 font-bold flex items-center justify-center text-sm shrink-0 opt-badge">${optionLabels[idx]}</span>
                    <span class="text-base">${optText}</span>
                `;
                optsContainer.appendChild(btn);
            });
        }

        // CHECK ANSWER
        function checkAnswer(selectedIndex) {
            const q = generatedQuizData[currentQuizIndex];
            const isCorrect = selectedIndex === q.answerIndex;

            const buttons = document.querySelectorAll('.option-btn');
            buttons.forEach((btn, idx) => {
                btn.disabled = true;
                if (idx === q.answerIndex) {
                    btn.className = "w-full text-left p-4 rounded-2xl border-2 border-green-500 bg-green-50 text-green-900 font-bold flex items-center gap-3";
                } else if (idx === selectedIndex && !isCorrect) {
                    btn.className = "w-full text-left p-4 rounded-2xl border-2 border-red-400 bg-red-50 text-red-900 font-semibold flex items-center gap-3";
                }
            });

            const feedbackBox = document.getElementById('feedbackBox');
            const feedbackText = document.getElementById('feedbackText');
            
            if (isCorrect) {
                score++;
                feedbackBox.className = "p-4 rounded-2xl font-bold flex items-center justify-between bg-green-100 text-green-800 border border-green-200";
                feedbackText.innerHTML = `<i class="fa-solid fa-circle-check text-xl mr-2"></i> Benar Sekali! ${q.explanation || ''}`;
            } else {
                feedbackBox.className = "p-4 rounded-2xl font-bold flex items-center justify-between bg-red-100 text-red-800 border border-red-200";
                feedbackText.innerHTML = `<i class="fa-solid fa-circle-xmark text-xl mr-2"></i> Kurang Tepat. Jawaban benar: ${q.options[q.answerIndex]}`;
            }

            feedbackBox.classList.remove('hidden');
        }

        // NEXT QUESTION OR FINISH
        function nextQuestion() {
            currentQuizIndex++;
            if (currentQuizIndex < generatedQuizData.length) {
                renderCurrentQuestion();
            } else {
                finishQuiz();
            }
        }

        // FINISH QUIZ & SHOW RESULTS
        function finishQuiz() {
            showSection('result');
            
            const totalQuestions = generatedQuizData.length;
            const finalCalculatedScore = Math.round((score / totalQuestions) * 100);

            document.getElementById('finalScore').innerText = finalCalculatedScore;
            document.getElementById('scoreDetails').innerText = `Benar ${score} dari ${totalQuestions} Soal`;

            if (finalCalculatedScore >= 80) {
                document.getElementById('resultEmoji').innerText = "🏆";
                document.getElementById('resultTitle').innerText = `Hebat Sekali, ${currentStudent.name}!`;
                document.getElementById('resultSubtitle').innerText = "Kamu menyelesaikan kuis dengan nilai yang sangat membanggakan!";
                confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });
            } else if (finalCalculatedScore >= 60) {
                document.getElementById('resultEmoji').innerText = "🌟";
                document.getElementById('resultTitle').innerText = `Bagus, ${currentStudent.name}!`;
                document.getElementById('resultSubtitle').innerText = "Terus tingkatkan latihanmu ya!";
            } else {
                document.getElementById('resultEmoji').innerText = "💪";
                document.getElementById('resultTitle').innerText = "Tetap Semangat!";
                document.getElementById('resultSubtitle').innerText = "Jangan menyerah, ayo baca materinya lagi dan coba kuis ini!";
            }

            // Save history for parent portal
            saveQuizResult(finalCalculatedScore);
        }

        // SAVE HISTORY TO LOCAL STORAGE
        function saveQuizResult(finalScore) {
            const history = JSON.parse(localStorage.getItem('quiz_history') || '[]');
            const record = {
                studentId: currentStudent.id,
                studentName: currentStudent.name,
                subject: currentSubject,
                topic: currentTopic,
                grade: currentStudent.grade,
                semester: currentSemester,
                score: finalScore,
                date: new Date().toLocaleString('id-ID', { dateStyle: 'short', timeStyle: 'short' })
            };
            history.unshift(record);
            localStorage.setItem('quiz_history', JSON.stringify(history));
            renderParentHistory();
        }

        // PARENT PORTAL MODAL LOGIC
        function openParentModal() {
            document.getElementById('parentModal').classList.remove('hidden');
            document.getElementById('parentPinState').classList.remove('hidden');
            document.getElementById('parentDashboardState').classList.add('hidden');
            document.getElementById('parentPinInput').value = '';
        }

        function closeParentModal() {
            document.getElementById('parentModal').classList.add('hidden');
        }

        function verifyParentPin() {
            const input = document.getElementById('parentPinInput').value;
            if (input === parentPin || input === '1234') {
                document.getElementById('parentPinState').classList.add('hidden');
                document.getElementById('parentDashboardState').classList.remove('hidden');
                renderParentHistory();
            } else {
                alert("PIN Salah! Default PIN adalah 1234");
            }
        }

        // RENDER PARENT HISTORY & STATS
        function renderParentHistory() {
            const history = JSON.parse(localStorage.getItem('quiz_history') || '[]');
            const tbody = document.getElementById('parentHistoryBody');
            tbody.innerHTML = '';

            // Calculate Stats
            const khalilatulRecords = history.filter(h => h.studentId === 'khalilatul');
            const hafizRecords = history.filter(h => h.studentId === 'hafiz');

            document.getElementById('khalilatulCount').innerText = `${khalilatulRecords.length} Kuis Selesai`;
            document.getElementById('hafizCount').innerText = `${hafizRecords.length} Kuis Selesai`;

            const khalilatulAvg = khalilatulRecords.length ? Math.round(khalilatulRecords.reduce((a, b) => a + b.score, 0) / khalilatulRecords.length) : 0;
            const hafizAvg = hafizRecords.length ? Math.round(hafizRecords.reduce((a, b) => a + b.score, 0) / hafizRecords.length) : 0;

            document.getElementById('khalilatulAvg').innerText = khalilatulAvg;
            document.getElementById('hafizAvg').innerText = hafizAvg;

            document.getElementById('khalilatulLastMat').innerText = khalilatulRecords.length ? `${khalilatulRecords[0].subject} - ${khalilatulRecords[0].topic}` : '-';
            document.getElementById('hafizLastMat').innerText = hafizRecords.length ? `${hafizRecords[0].subject} - ${hafizRecords[0].topic}` : '-';

            if (history.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="p-4 text-center text-slate-400">Belum ada riwayat kuis yang dikerjakan.</td></tr>`;
                return;
            }

            history.forEach(item => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="p-3 font-bold text-slate-800">${item.studentName}</td>
                    <td class="p-3">${item.subject} <br/><span class="text-[10px] text-slate-500">${item.topic}</span></td>
                    <td class="p-3">Kelas ${item.grade} (Sem ${item.semester})</td>
                    <td class="p-3 font-extrabold ${item.score >= 70 ? 'text-green-600' : 'text-red-500'}">${item.score}</td>
                    <td class="p-3 text-slate-400">${item.date}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        function clearHistory() {
            if (confirm("Apakah Anda yakin ingin menghapus seluruh riwayat kuis anak?")) {
                localStorage.removeItem('quiz_history');
                renderParentHistory();
            }
        }
    </script>
