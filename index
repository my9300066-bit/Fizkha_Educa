<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Petualangan Belajar - Kurikulum Merdeka</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            pink: '#FF6B6B',
                            yellow: '#FFD93D',
                            green: '#6BCB77',
                            blue: '#4D96FF',
                            purple: '#9B51E0',
                            darkPurple: '#2C1A4D'
                        }
                    },
                    fontFamily: {
                        fredoka: ['Fredoka', 'sans-serif'],
                        nunito: ['Nunito', 'sans-serif']
                    }
                }
            }
        }
    </script>
    
    <style>
        body {
            font-family: 'Nunito', sans-serif;
            background-color: #F8F9FE;
        }
        h1, h2, h3, h4, .font-heading {
            font-family: 'Fredoka', sans-serif;
        }
        .bounce-hover:hover {
            transform: translateY(-5px);
            transition: all 0.2s ease;
        }
        .card-shadow {
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb {
            background: #4D96FF;
            border-radius: 10px;
        }
    </style>
</head>
<body class="bg-indigo-50/50 min-h-screen text-slate-800 flex flex-col justify-between">

    <!-- Header Navigation -->
    <header class="bg-white border-b-4 border-yellow-400 sticky top-0 z-50 shadow-sm">
        <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center gap-3 cursor-pointer" onclick="showSection('dashboard')">
                <div class="w-12 h-12 bg-yellow-400 rounded-2xl flex items-center justify-center text-white text-2xl font-bold shadow-md transform -rotate-3">
                    <i class="fa-solid fa-graduation-cap"></i>
                </div>
                <div>
                    <h1 class="text-xl md:text-2xl font-bold text-indigo-900 leading-tight">Dunia Belajar</h1>
                    <p class="text-xs text-indigo-500 font-bold tracking-wider uppercase">Kurikulum Merdeka</p>
                </div>
            </div>

            <!-- Profile Info & Parent Portal Toggle -->
            <div class="flex items-center gap-3">
                <div id="activeProfileTag" class="hidden md:flex items-center gap-2 bg-indigo-50 border border-indigo-200 px-3 py-1.5 rounded-full">
                    <div id="tagAvatar" class="w-7 h-7 rounded-full flex items-center justify-center text-white text-xs font-bold"></div>
                    <span id="tagName" class="text-sm font-bold text-indigo-900"></span>
                    <span id="tagGrade" class="text-xs bg-indigo-200 text-indigo-800 px-2 py-0.5 rounded-full font-semibold"></span>
                </div>

                <button onclick="openParentModal()" class="bg-purple-600 hover:bg-purple-700 text-white font-bold px-4 py-2 rounded-xl text-sm transition flex items-center gap-2 shadow-md hover:shadow-lg">
                    <i class="fa-solid fa-user-shield"></i>
                    <span>Area Orang Tua</span>
                </button>
            </div>
        </div>
    </header>

    <!-- MAIN CONTAINER -->
    <main class="max-w-6xl mx-auto px-4 py-6 flex-1 w-full">

        <!-- ================= DASHBOARD SECTION ================= -->
        <section id="dashboardSection" class="space-y-8">
            <!-- Welcome Banner -->
            <div class="bg-gradient-to-r from-blue-500 via-indigo-500 to-purple-600 rounded-3xl p-6 md:p-8 text-white shadow-xl relative overflow-hidden">
                <div class="absolute -right-10 -bottom-10 opacity-20 text-9xl font-bold">
                    <i class="fa-solid fa-rocket"></i>
                </div>
                <div class="relative z-10 max-w-2xl">
