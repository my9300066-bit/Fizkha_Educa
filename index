                    <h2 class="text-2xl md:text-4xl font-extrabold mb-2">Pilih Profil & Mulai Petualangan Belajarmu!</h2>
                    <p class="text-indigo-100 text-sm md:text-base">Pilih nama kamu, kelas, dan semester untuk mulai belajar materi seru dan mengerjakan kuis pilihan ganda.</p>
                </div>
            </div>

            <!-- Profile Selection Cards -->
            <div>
                <h3 class="text-xl font-bold text-indigo-950 mb-4 flex items-center gap-2">
                    <i class="fa-solid fa-user-astronaut text-indigo-500"></i> Pilih Profil Anak:
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Khalilatul Ilmiyah Card -->
                    <div onclick="selectStudent('khalilatul')" id="card-khalilatul" class="bg-white rounded-3xl p-6 border-4 border-transparent hover:border-pink-400 transition-all cursor-pointer card-shadow relative overflow-hidden group hover:-translate-y-1 duration-300">
                        <div class="flex items-start gap-4">
                            <div class="w-20 h-20 bg-pink-100 rounded-2xl flex items-center justify-center text-4xl text-pink-500 shadow-inner group-hover:scale-105 transition">
                                👩‍🎓
                            </div>
                            <div class="flex-1">
                                <span class="bg-pink-100 text-pink-600 text-xs font-bold px-2.5 py-1 rounded-lg">Kelas 3 SD</span>
                                <h4 class="text-2xl font-bold text-slate-800 mt-1">Khalilatul Ilmiyah</h4>
                                <p class="text-slate-500 text-sm mt-1"><i class="fa-solid fa-book-open text-pink-400 mr-1"></i> Kurikulum Merdeka - Fase B</p>
                            </div>
                        </div>
                        <div class="mt-4 pt-4 border-t border-slate-100 flex justify-between items-center text-sm font-semibold text-pink-500">
                            <span>Klik untuk memilih</span>
                            <i class="fa-solid fa-circle-arrow-right text-xl"></i>
                        </div>
                    </div>

                    <!-- Hafiz Muayyad Card -->
                    <div onclick="selectStudent('hafiz')" id="card-hafiz" class="bg-white rounded-3xl p-6 border-4 border-transparent hover:border-blue-400 transition-all cursor-pointer card-shadow relative overflow-hidden group hover:-translate-y-1 duration-300">
