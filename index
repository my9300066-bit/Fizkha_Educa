                            <div class="w-20 h-20 bg-blue-100 rounded-2xl flex items-center justify-center text-4xl text-blue-500 shadow-inner group-hover:scale-105 transition">
                                👨‍🎓
                            </div>
                            <div class="flex-1">
                                <span class="bg-blue-100 text-blue-600 text-xs font-bold px-2.5 py-1 rounded-lg">Kelas 1 SD</span>
                                <h4 class="text-2xl font-bold text-slate-800 mt-1">Hafiz Muayyad</h4>
